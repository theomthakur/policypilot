# PolicyPilot configuration. Copy to .env and fill in secrets. Never commit .env.

# ---- App ----
APP_ENV=development                 # development | test | production
APP_VERSION=0.1.0
LOG_LEVEL=INFO
API_PORT=8000
PUBLIC_ORIGIN=http://localhost:8080 # CORS / cookie origin; set to https://your-domain in production
DEMO_PASSCODE=                      # empty disables the gate (local); set in production
SESSION_COOKIE_SECURE=false         # true in production (HTTPS)

# ---- PostgreSQL ----
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=policypilot
POSTGRES_USER=policypilot
POSTGRES_PASSWORD=change-me

# ---- Redis ----
REDIS_URL=redis://redis:6379/0
SESSION_TTL_SECONDS=86400
SEARCH_CACHE_TTL_SECONDS=900
INGEST_STATUS_TTL_SECONDS=3600

# ---- LLM (OpenAI-compatible) ----
LLM_PROVIDER=openai_compatible      # openai_compatible / offline (no key, extractive) / fake (tests and CI)
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=                        # secret
LLM_MODEL=openai/gpt-4o-mini
LLM_TEMPERATURE=0
LLM_SEED=42                         # best effort; recorded with every run
LLM_REQUEST_TIMEOUT_S=30

# ---- Embeddings ----
EMBEDDING_PROVIDER=local            # local (fastembed ONNX) | openai
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384

# ---- Retrieval ----
CHUNK_TOKENS=350
CHUNK_OVERLAP_TOKENS=50
SEARCH_CANDIDATES=20
SEARCH_TOP_K_DEFAULT=6
RRF_K=60
WEAK_SCORE_THRESHOLD=0.02

# ---- Agent limits ----
AGENT_MAX_STEPS=8
AGENT_MAX_TOOL_CALLS=6
AGENT_MAX_QUERY_REVISIONS=2
AGENT_MAX_TOOL_RETRIES=1
AGENT_TOOL_TIMEOUT_S=8
AGENT_TURN_TIMEOUT_S=60
AGENT_MAX_TOKENS_PER_TURN=25000
AGENT_MAX_PAGES_PER_READ=3

# ---- Uploads ----
UPLOAD_MAX_MB=10
UPLOAD_MAX_PAGES=100
UPLOAD_DIR=/data/uploads
CORPUS_DIR=/app/corpus/pdfs

# ---- Public safety ----
RATE_LIMIT_PER_MINUTE=20
DAILY_BUDGET_USD=1.00
FAULT_INJECTION_ENABLED=false       # true only for evaluation runs
